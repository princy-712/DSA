'''
class Node:
    def __init__(self, val):
        self.data = val
        self.left = None
        self.right = None
'''

class Solution:
    def sortedArrayToBST(self, arr):
        # code here
        return self.helper(arr, 0, len(arr)-1)
        
        
    def helper(self, arr, start, end):
        

        if start>end:
            return None
        
        mid = (start + end) // 2
        root = Node(arr[mid])
        root.left = self.helper(arr,start, mid-1)
        root.right =self.helper(arr, mid+1, end)
        return root
    

   