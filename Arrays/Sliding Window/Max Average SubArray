def max_sum_subarray(arr, k):

    window_sum = sum(arr[:k])
    max_sum = window_sum

    for i in range(k, len(arr)):

        window_sum = window_sum + arr[i] - arr[i-k]

        max_sum = max(max_sum, window_sum)

    return max_sum
class Solution:
    def findMaxAverage(self, arr, n, k):

        window_sum = sum(arr[:k])
        max_sum = window_sum
        start_index = 0

        for i in range(k, n):

            window_sum += arr[i]
            window_sum -= arr[i-k]

            if window_sum > max_sum:
                max_sum = window_sum
                start_index = i-k+1

        return start_index