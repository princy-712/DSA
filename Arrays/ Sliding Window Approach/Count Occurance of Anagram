from collections import Counter

class Solution:
    def search(self, pat, txt):

        k = len(pat)
        freq = Counter(pat)

        count = len(freq)
        i = 0
        ans = 0

        for j in range(len(txt)):

            if txt[j] in freq:
                freq[txt[j]] -= 1
                if freq[txt[j]] == 0:
                    count -= 1

            if j - i + 1 == k:

                if count == 0:
                    ans += 1

                if txt[i] in freq:
                    if freq[txt[i]] == 0:
                        count += 1
                    freq[txt[i]] += 1

                i += 1

        return ans